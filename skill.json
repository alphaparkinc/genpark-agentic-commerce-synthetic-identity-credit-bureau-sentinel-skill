          },
          "primary_tradelines_count": {
            "type": "integer"
          },
          "credit_file_depth_months": {
            "type": "integer"
          }
        },
        "required": [
          "applicant_id",
          "applicant_dob_year",
          "ssn_estimated_issuance_year",
          "authorized_user_tradelines_count",
          "primary_tradelines_count"
        ]
